# -----------------------------------------------------------------------------
# PairUp Core Backend - Environment Configuration Template
# -----------------------------------------------------------------------------
# NOTE: Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or .env files to version control.

# Application Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="PairUp Core Backend"
APP_URL=http://localhost:3000

# CORS Configuration (comma-separated origins allowed to access the API)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# PostgreSQL Database (Primary Data Store)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://pairup_user:pairup_password@localhost:5432/pairup_db?schema=public

# Redis (Caching, Session Blacklisting, and Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
# In production, use cryptographically secure random 64-character strings
JWT_ACCESS_SECRET=pairup_jwt_access_secret_for_local_development_only_change_in_production_384918239
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=pairup_jwt_refresh_secret_for_local_development_only_change_in_production_918237194
JWT_REFRESH_EXPIRATION=7d

# Verification & Password Reset Token Expirations
EMAIL_VERIFICATION_EXPIRATION_HOURS=24
PASSWORD_RESET_EXPIRATION_MINUTES=60

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Discovery & Matching Engine Defaults
DEFAULT_MAX_DISTANCE_KM=50
MAX_DISCOVERY_BATCH_SIZE=20

# Feature Flags
ENABLE_SWAGGER=true
ENABLE_SEED_ENDPOINT=false
