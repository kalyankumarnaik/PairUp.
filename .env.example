# ==============================================================================
# PAIRUP AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting the development environment.
# In local development mode without external services, sensible fallbacks are used.

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
WEB_PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# DATABASE & CACHE
# ------------------------------------------------------------------------------
# PostgreSQL database with PostGIS extensions enabled
DATABASE_URL=postgresql://pairup_user:pairup_secure_pass@localhost:5432/pairup_db?schema=public
DIRECT_URL=postgresql://pairup_user:pairup_secure_pass@localhost:5432/pairup_db?schema=public

# Redis connection for caching, real-time presence and BullMQ background workers
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=pairup_dev_jwt_access_secret_change_in_production_min32chars
JWT_REFRESH_SECRET=pairup_dev_jwt_refresh_secret_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# INITIAL ADMIN SEED
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@pairup.ai
ADMIN_PASSWORD=AdminSecurePairUp2026!
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# ------------------------------------------------------------------------------
# MEDIA & OBJECT STORAGE (S3 COMPATIBLE)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=pairup-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
CDN_BASE_URL=http://localhost:4000/uploads

# ------------------------------------------------------------------------------
# REAL-TIME & WEBRTC (AUDIO / VIDEO CALLS)
# ------------------------------------------------------------------------------
# LiveKit / Agora credentials for WebRTC SFU calls
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=wss://livekit.pairup.local

# ------------------------------------------------------------------------------
# SMS & VERIFICATION (TWILIO / MSG91)
# ------------------------------------------------------------------------------
# When SMS_DEV_MODE=true, OTP is logged to server console or defaults to 123456
SMS_DEV_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# AI PROVIDER (GOOGLE GEMINI / OPENAI)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_FALLBACK_MODE=true

# ------------------------------------------------------------------------------
# GEOLOCATION & MAPS
# ------------------------------------------------------------------------------
DEFAULT_LATITUDE=19.0760
DEFAULT_LONGITUDE=72.8777
DEFAULT_CITY="Mumbai, India"
MAX_DISCOVERY_RADIUS_KM=50
MIN_AGE_REQUIREMENT=18
