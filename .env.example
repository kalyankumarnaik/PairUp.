# -----------------------------------------------------------------------------
# PairUp Core Backend - Environment Configuration Template
# -----------------------------------------------------------------------------
# NOTE: Copy this file to .env and adjust values for your local environment.
# Never commit real credentials or .env files to version control.

# Application Server
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="PairUp Core Backend"
APP_URL=http://localhost:3000

# CORS Configuration (comma-separated origins allowed to access the API)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080

# PostgreSQL Database (Primary Data Store)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
DATABASE_URL=postgresql://pairup_user:pairup_password@localhost:5432/pairup_db?schema=public

